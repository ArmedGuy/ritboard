[Unit]
Description=Ritboard planning board
After=network-online.target

[Service]
# Installed with `uv tool install .`; adjust the path if uv puts tools elsewhere.
ExecStart=%h/.local/bin/ritboard serve --host 127.0.0.1 --port 8765
Restart=on-failure
# Environment=RITBOARD_TOKEN=change-me
# Environment=RITBOARD_DATA=%h/ritboard-data

[Install]
WantedBy=default.target
